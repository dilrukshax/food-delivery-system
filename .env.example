# Example environment variables for the Food Ordering and Delivery System.
# Copy to ".env" (gitignored) and replace placeholders with rotated secrets.
# Do NOT commit real secrets. Treat all values previously in this repository's
# history as compromised — rotate them before reuse.

# ---- PostgreSQL (shared instance, one DB per service) ----
POSTGRES_PASSWORD=your-rotated-postgres-password
SPRING_DATASOURCE_USERNAME=postgres

# Per-service database URLs (Spring Boot style):
USER_SERVICE_DB_URL=jdbc:postgresql://localhost:5432/user_service_db
RESTAURANT_SERVICE_DB_URL=jdbc:postgresql://localhost:5432/restaurant_service_db
ORDER_SERVICE_DB_URL=jdbc:postgresql://localhost:5432/order_service_db
PAYMENT_SERVICE_DB_URL=jdbc:postgresql://localhost:5432/payment_service_db
DELIVERY_SERVICE_DB_URL=jdbc:postgresql://localhost:5432/delivery_service_db
NOTIFICATION_SERVICE_DB_URL=jdbc:postgresql://localhost:5432/notification_service_db

# ---- JWT (shared across user-service and api-gateway) ----
JWT_SECRET=your-rotated-256-bit-secret-key
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ---- Stripe (payment-service) ----
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key

# ---- Azure Blob Storage (user-service / restaurant-service) ----
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-rotated-key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=user-profile-images

# ---- Eureka (service registry) ----
EUREKA_CLIENT_SERVICE_URL_DEFAULT_ZONE=http://localhost:8761/eureka/

# ---- Spring Mail (notification-service) ----
SPRING_MAIL_HOST=smtp.your-provider.example
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-smtp-username
SPRING_MAIL_PASSWORD=your-smtp-password
